{
  "name": "dsh-golden-partner",
  "version": "0.1.0",
  "type": "module",
  "description": "Hands a repo context pack to an external planning model, then brings the brief back as a plan file. Long text stays on disk; the conversation only carries paths and counts.",
  "license": "MIT",
  "author": "潇色君",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaosejun/dsh-golden-partner.git"
  },
  "homepage": "https://github.com/xiaosejun/dsh-golden-partner#readme",
  "bugs": {
    "url": "https://github.com/xiaosejun/dsh-golden-partner/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "handoff",
    "context-pack",
    "planning"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
